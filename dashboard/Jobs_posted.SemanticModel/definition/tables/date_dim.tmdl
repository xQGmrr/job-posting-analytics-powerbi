	partition date_dim = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "date_key",FORMAT([Date],"YYYYMMDD"),
				     "Year",YEAR([Date]),
				     "month_number",MONTH([Date]),
				     "month_name",FORMAT([Date],"mmmm"),
				     "year_month",FORMAT([Date],"YYYY-MM"),
				     "quarter","Q"&FORMAT([Date],"Q"),
				     "week_number",WEEKNUM([Date],1),
				     "weekday_number",WEEKDAY([Date],1),
				     "weekday_name",FORMAT([Date],"dddd")
				)

